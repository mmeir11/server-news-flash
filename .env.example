NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_TOKEN_SECRET=change-this-local-development-secret
AUTH_TOKEN_TTL_SECONDS=604800

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsflash
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/newsflash

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 api tokens page
# https://dash.cloudflare.com/86abbf85946e526e85c0c2eabab6a3e6/r2/api-tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=newsflash-media
R2_PUBLIC_BASE_URL=https://media.example.com
R2_UPLOAD_URL_TTL_SECONDS=900